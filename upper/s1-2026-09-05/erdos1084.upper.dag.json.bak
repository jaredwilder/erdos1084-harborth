   "lean_signature": "theorem polar_angle_eq_arccos_cos, theorem polar_angle_add",
   "lean_statement_line": "theorem o06_convex_polygon_angle_sum (h : ℕ) (hh : 3 ≤ h) (p : ℕ → ℝ^ 2)\n    (hper : p h = p 0) (hper' : p (h + 1) = p 1)\n    (hfront : ∀ i, i < h → p i ∈ frontier (convexHull ℝ (Set.range p)))\n    (hinj : ∀ i, i < h → ∀ j, j < h → p i = p j → i = j)\n    (hcyclic : ∀ i, i < h → ∀ j, j < h →\n      EuclideanGeometry.angle (p i) (p (i + 1)) (p (i + 2)) ≤ Real.pi) :\n    ∑ i ∈ Finset.range h, EuclideanGeometry.angle (p i) (p (i + 1)) (p (i + 2))\n      = ((h : ℝ) - 2) * Real.pi := by\n  sorry",
   "lean_file_sha256": "f9154da5cc20e5031b11342b781dcb8054532c48520d57c1ce8560a2d07b1a31",
