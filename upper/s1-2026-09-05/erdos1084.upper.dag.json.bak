   "id": "erdos1084:UPPER:O01",
   "statement": "theorem o01_sixty_degree_gap (x y z : ℝ^ 2)\n    (hxy : dist x y = 1) (hxz : dist x z = 1) (hyz : 1 ≤ dist y z) :\n    Real.pi / 3 ≤ EuclideanGeometry.angle y x z",
   "kind": "LEMMA",
